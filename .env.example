# Configurações do Supabase (Front-end)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Configurações para Supabase Edge Functions (Secrets no Supabase CLI):
# supabase secrets set ASAAS_API_KEY="$aact_sua_chave_asaas_aqui"
# supabase secrets set ASAAS_WEBHOOK_TOKEN="seu_token_secreto_forte_aqui"
# supabase secrets set ASAAS_ENV="production" # ou "sandbox"
